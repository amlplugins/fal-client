{
  "name": "@amlplugins/fal-client",
  "version": "0.0.1",
  "description": "Native @fal-ai/client SDK re-exported under the @amlplugins namespace — Fal.ai Client — serverless generative-AI gateway (image, video, audio, 3D) with subscribe/run/queue APIs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amlplugins/fal-client.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
